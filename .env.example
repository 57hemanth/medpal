# Copy to .env for local overrides. Never commit .env.
MEDPAL_ENV=dev
# The app connects as a NON-superuser so row-level security applies; migrations/seeding use the owner.
MEDPAL_DATABASE_URL=postgresql://medpal_app:medpal_app@localhost:5433/medpal
MEDPAL_MIGRATION_DATABASE_URL=postgresql://medpal:medpal@localhost:5433/medpal
# dev: mobile sign-in with the code shown on screen, plus X-Dev-* headers for scripts.
# otp: mobile sign-in only (needs a real SMS provider and secret). oidc: bearer tokens from your identity provider.
MEDPAL_AUTH_MODE=dev
# Signs session cookies and one-time codes. Set a long random value outside development.
# MEDPAL_SESSION_SECRET=
# MEDPAL_SESSION_HOURS=12

# Appointment emails. Development: `make up` starts Mailpit; read the mail at http://localhost:8025.
# Production: your SMTP provider (e.g. Amazon SES in ap-south-1), with STARTTLS and credentials.
MEDPAL_EMAIL_PROVIDER=smtp
MEDPAL_SMTP_HOST=localhost
MEDPAL_SMTP_PORT=1025
# MEDPAL_EMAIL_FROM="MedPal <appointments@your-domain>"
# MEDPAL_PUBLIC_BASE_URL=http://localhost:8000
# Who sends due emails: inline (the API), worker (arq) or off.
# MEDPAL_NOTIFY_DISPATCH=inline

# Persistent private local objects for development; select s3 for deployment.
MEDPAL_OBJECT_STORE_BACKEND=file
MEDPAL_OBJECT_STORE_DIRECTORY=.medpal/objects
MEDPAL_OBJECT_STORE_BUCKET=medpal-records
MEDPAL_OBJECT_STORE_REGION=ap-south-1
# MEDPAL_OBJECT_STORE_ENDPOINT_URL=https://your-private-s3-endpoint
# Prefer workload credentials; only set these for a private S3-compatible service if needed.
# MEDPAL_OBJECT_STORE_ACCESS_KEY_ID=
# MEDPAL_OBJECT_STORE_SECRET_ACCESS_KEY=

# Optional offline speech: uv sync --all-groups --extra speech
# Provision a faster-whisper model directory locally before enabling; no runtime downloads.
# MEDPAL_SPEECH_MODEL_PATH=/absolute/path/to/local-whisper-model

# Hosted model (Gemini). Text is de-identified before it leaves; see docs/adr/0006 and 0008.
# Check the exact model ids in Google AI Studio and prices on https://ai.google.dev/gemini-api/docs/pricing
# MEDPAL_CHAT_PROVIDER=gemini
# MEDPAL_CHAT_MODEL=gemini-4-argon          # large tier: records answers, note drafts
# MEDPAL_CHAT_SMALL_MODEL=gemini-3.8-flash  # small tier: assistant routing
# MEDPAL_CHAT_API_KEY=your-gemini-api-key
# Reasoning effort for routing (low: same accuracy, half the latency in `make live-check`).
# Leave the large tier on the provider default.
# MEDPAL_CHAT_SMALL_THINKING_LEVEL=low
# Which tier answers records questions. Measured on Gemini: small scored the same on `make live-check`
# with about a quarter of the p95 latency and cost (see docs/implementation-status.md).
# MEDPAL_RECORDS_MODEL_TIER=small
# Fallback, tried when the primary fails, times out or returns invalid output. A fallback on the same
# provider reuses MEDPAL_CHAT_API_KEY; another provider needs MEDPAL_CHAT_FALLBACK_API_KEY.
# MEDPAL_CHAT_FALLBACK_PROVIDER=gemini
# MEDPAL_CHAT_FALLBACK_MODEL=gemini-3.8-flash
# Hard deadline per provider attempt, and SDK retries (the fallback chain decides what happens next).
# MEDPAL_CHAT_TIMEOUT_SECONDS=30
# MEDPAL_CHAT_MAX_RETRIES=1
# Cost metering (USD per 1M tokens, thinking billed as output), stamped with the date you read the prices:
# MEDPAL_MODEL_PRICES={"gemini-4-argon": {"in": 2.00, "out": 10.00}, "gemini-3.8-flash": {"in": 0.75, "out": 3.75}}
# MEDPAL_PRICE_LIST_DATE=2026-11-03
